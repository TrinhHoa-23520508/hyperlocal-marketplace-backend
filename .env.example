# Local development configuration. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Read by Docker Compose (compose.yaml) and by Spring Boot (spring.config.import).
# Format: KEY=value, no quotes. Real environment variables override this file.
# Production uses deploy/.env.example instead.

# PostgreSQL + PostGIS container. Host port 5433 avoids a PostgreSQL installed on the machine (5432).
POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby
POSTGRES_PORT=5433
DB_POOL_SIZE=10

# Redis container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT: HS256 secret of at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32b+
JWT_ISSUER=nearby-backend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO container
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# Host the Android app uses for presigned image URLs (signatures are bound to this host):
#   emulator: http://10.0.2.2:9000   real phone on the same Wi-Fi: http://<LAN-IP>:9000
MINIO_PUBLIC_ENDPOINT=http://10.0.2.2:9000
MINIO_ACCESS_KEY=nearby
MINIO_SECRET_KEY=nearby-secret
MINIO_BUCKET=nearby-images
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL=10m

# RabbitMQ container: STOMP broker relay for chat across replicas
RABBITMQ_AMQP_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_USER=nearby
RABBITMQ_PASSWORD=nearby-secret
# false: in-memory broker, correct for a single instance only
WS_RELAY_ENABLED=true

# Push notifications (FCM HTTP v1). Empty = pushes are only logged.
FCM_CREDENTIALS=

# Server
SERVER_PORT=8080
IDEMPOTENCY_TTL=24h

# SMS one-time codes (FR-ID-02, ADR-18). See docs/setup-local.md section 2.1.
#   log:  the code is written to the backend log (search "[sms disabled]"); local development only
#   esms: sent for real through eSMS.vn
SMS_PROVIDER=log
ESMS_BASE_URL=https://rest.esms.vn/MainService.svc/json
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Brandname registered with eSMS (case-sensitive)
ESMS_BRANDNAME=
# 2 = customer care / OTP brandname route
ESMS_SMS_TYPE=2
# true: eSMS validates key, brandname and template but neither delivers nor charges
ESMS_SANDBOX=true
ESMS_TIMEOUT=10s
# Must match the template registered with eSMS character for character; {code} is the 6-digit code
SMS_OTP_TEMPLATE={code} la ma xac minh Nearby cua ban, het han sau 5 phut. Khong chia se ma nay.
# HMAC key for the code hashes kept in Redis, at least 32 bytes. Generate with: openssl rand -base64 48
OTP_HASH_SECRET=local-dev-otp-secret-change-me-please-32b+

# Account emails (FR-ID-07, FR-ID-09). See docs/setup-local.md section 2.2 for Gmail.
# With MAIL_ENABLED=false the verification and password reset links are written to the log instead.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail address and its 16-character App Password (not the normal Gmail password)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Nearby <no-reply@nearby.local>
# Links in the emails; the token is appended as ?token=...
EMAIL_VERIFICATION_URL=nearby://verify-email
PASSWORD_RESET_URL=nearby://reset-password

# First admin account, created on startup if no account uses this email yet
ADMIN_EMAIL=admin@nearby.local
ADMIN_PASSWORD=Nearby2026

# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server of the admin console.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local monitoring (docker compose --profile monitoring up -d)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
