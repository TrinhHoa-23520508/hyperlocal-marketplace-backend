{
  "info": {
    "name": "Nearby - Listing API",
    "description": "Listing and discovery (SRS 3.3, 3.4). Run the identity and area collections first (same phone and password, one verified area), then these folders in order. Step 3 needs a JPEG picked in its Body tab. Contract: docs/api/listing-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "phone",
      "value": "0912345678"
    },
    {
      "key": "password",
      "value": "Secret123"
    },
    {
      "key": "latitude",
      "value": "10.8700"
    },
    {
      "key": "longitude",
      "value": "106.8031"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "areaId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    },
    {
      "key": "uploadUrl",
      "value": ""
    },
    {
      "key": "postKey",
      "value": ""
    },
    {
      "key": "listingId",
      "value": ""
    },
    {
      "key": "version",
      "value": "0"
    },
    {
      "key": "feedCursor",
      "value": ""
    },
    {
      "key": "sellerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup (log in, area, categories)",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Log in as the user of the identity and area collections (it needs a verified area); keeps the token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "My areas (pick the active one)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "me"
              ]
            },
            "description": "Keeps the first VERIFIED or EXPIRING area for the listing (run the area collection FA1 first)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const area = pm.response.json().find(a => a.status === \"VERIFIED\" || a.status === \"EXPIRING\");",
                  "pm.test(\"has a valid area\", () => pm.expect(area).to.not.be.undefined);",
                  "pm.collectionVariables.set(\"areaId\", area.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Public; A08 and A12 category picker.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"9 categories\", () => pm.expect(pm.response.json().length).to.be.at.least(9));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. FL1 Post a listing (A12, A13)",
      "item": [
        {
          "name": "1. Posting eligibility",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/posting-eligibility",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "posting-eligibility"
              ]
            },
            "description": "UC-LS-01 step 1: the gate and the remaining quota."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"can post\", () => pm.expect(pm.response.json().canPost).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Upload URL for one image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/images/upload-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "images",
                "upload-url"
              ]
            },
            "description": "FR-LS-02: one presigned PUT per image.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"image/jpeg\",\n  \"sizeBytes\": 50000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"imageId\", t.imageId);",
                  "pm.collectionVariables.set(\"uploadUrl\", t.uploadUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. PUT the bytes to the presigned URL",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": {
              "raw": "{{uploadUrl}}"
            },
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "description": "Pick a JPEG under 5 MB in the Body tab (binary) before running. Goes straight to object storage.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Upload complete",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/images/{{imageId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "images",
                "{{imageId}}",
                "complete"
              ]
            },
            "description": "UC-SY-10 starts; 202 UPLOADING."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Image status (repeat until READY)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/images/{{imageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "images",
                "{{imageId}}"
              ]
            },
            "description": "Poll until READY or REJECTED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"READY\", () => pm.expect(pm.response.json().status).to.eql(\"READY\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Post the listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{postKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings"
              ]
            },
            "description": "UC-LS-01: 201 ACTIVE; the owner view carries the pin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaId\": \"{{areaId}}\",\n  \"title\": \"Áo khoác da nam\",\n  \"description\": \"Còn mới 90%, size L\",\n  \"condition\": \"LIKE_NEW\",\n  \"priceVnd\": 150000,\n  \"acceptOffers\": true,\n  \"meetingSpot\": \"Cổng KTX khu A\",\n  \"categoryId\": 4,\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"imageIds\": [\n    \"{{imageId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const l = pm.response.json();",
                  "pm.collectionVariables.set(\"listingId\", l.id);",
                  "pm.collectionVariables.set(\"version\", l.version);",
                  "pm.test(\"ACTIVE\", () => pm.expect(l.status).to.eql(\"ACTIVE\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"postKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6b. Same key, same body: replayed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{postKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings"
              ]
            },
            "description": "UC-LS-01 A4: the original 201, header Idempotent-Replayed: true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaId\": \"{{areaId}}\",\n  \"title\": \"Áo khoác da nam\",\n  \"description\": \"Còn mới 90%, size L\",\n  \"condition\": \"LIKE_NEW\",\n  \"priceVnd\": 150000,\n  \"acceptOffers\": true,\n  \"meetingSpot\": \"Cổng KTX khu A\",\n  \"categoryId\": 4,\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"imageIds\": [\n    \"{{imageId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6c. Error: title too short",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{postKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings"
              ]
            },
            "description": "400 VALIDATION_FAILED on title.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaId\": \"{{areaId}}\",\n  \"title\": \"Ghế\",\n  \"description\": \"Còn mới 90%, size L\",\n  \"condition\": \"LIKE_NEW\",\n  \"priceVnd\": 150000,\n  \"acceptOffers\": true,\n  \"meetingSpot\": \"Cổng KTX khu A\",\n  \"categoryId\": 4,\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"imageIds\": [\n    \"{{imageId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code is VALIDATION_FAILED\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_FAILED\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"postKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. FL2-FL3 Edit and manage (A14)",
      "item": [
        {
          "name": "Edit: lower the price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}"
              ]
            },
            "description": "UC-LS-02: send the whole form with version; publishes ListingPriceDropped.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Áo khoác da nam\",\n  \"description\": \"Còn mới 90%, size L\",\n  \"condition\": \"LIKE_NEW\",\n  \"priceVnd\": 120000,\n  \"acceptOffers\": true,\n  \"meetingSpot\": \"Cổng KTX khu A\",\n  \"categoryId\": 4,\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"imageIds\": [\n    \"{{imageId}}\"\n  ],\n  \"version\": {{version}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"version\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Hide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}/hide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}",
                "hide"
              ]
            },
            "description": "UC-LS-03.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{version}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"version\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: hide again with a stale version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}/hide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}",
                "hide"
              ]
            },
            "description": "409 CONCURRENT_MODIFICATION.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code is CONCURRENT_MODIFICATION\", () => pm.expect(pm.response.json().code).to.eql(\"CONCURRENT_MODIFICATION\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unhide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}/unhide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}",
                "unhide"
              ]
            },
            "description": "UC-LS-03.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{version}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"version\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Bump",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}/bump",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}",
                "bump"
              ]
            },
            "description": "UC-LS-06."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"version\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: bump again within 48 h",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/{{listingId}}/bump",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "{{listingId}}",
                "bump"
              ]
            },
            "description": "429 BUMP_TOO_SOON with nextAllowedAt and Retry-After."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 429\", () => pm.response.to.have.status(429));",
                  "pm.test(\"code is BUMP_TOO_SOON\", () => pm.expect(pm.response.json().code).to.eql(\"BUMP_TOO_SOON\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "My listings (ACTIVE tab)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/listings/me?status=ACTIVE&status=RESERVED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "listings",
                "me"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "status",
                  "value": "RESERVED"
                }
              ]
            },
            "description": "UC-LS-07: counts per state and rows with counters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"listed\", () => pm.expect(pm.response.json().items.map(i => i.id)).to.include(pm.collectionVariables.get(\"listingId\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. FL4-FL7 Browse: feed, search, map, detail",
      "item": [
        {
          "name": "Feed as a guest at a point",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/feed?lat={{latitude}}&lon={{longitude}}&rangeLevel=MEDIUM",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "feed"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{latitude}}"
                },
                {
                  "key": "lon",
                  "value": "{{longitude}}"
                },
                {
                  "key": "rangeLevel",
                  "value": "MEDIUM"
                }
              ]
            },
            "description": "UC-DC-01: public; 20 a page; no coordinates on cards.",
            "auth": {
