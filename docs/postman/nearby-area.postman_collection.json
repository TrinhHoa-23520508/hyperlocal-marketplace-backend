{
  "info": {
    "name": "Nearby - Area API",
    "description": "Area verification (SRS 3.2). Register the user with the identity collection first (same phone and password), then run the folders in order. Fixes use the current time, so run them right away. Contract: docs/api/area-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup (log in, consent, gate)",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Log in as the user registered with the identity collection; keeps the access token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Give location consent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/location-consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "location-consent"
              ]
            },
            "description": "PRECISE_LOCATION consent is required before any verification (FR-ID-15, FA1 step 1).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"termsVersion\": \"{{locationTermsVersion}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trading gate before any area",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/trading-gate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "trading-gate"
              ]
            },
            "description": "Closed with NO_VALID_AREA until an area is verified (F15).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gate is closed\", () => pm.expect(pm.response.json().open).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. FA1 Verify the first area",
      "item": [
        {
          "name": "Verify an area",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{verifyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "verifications"
              ]
            },
            "description": "UC-AR-01. 201 with the new area (200 when it renewed an area within 1 500 m). No coordinates come back.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": false,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"verifyKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"fixTime\", new Date(Date.now() - 5000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"areaId\", body.area.id);",
                  "pm.test(\"Area is VERIFIED and active\", () => { pm.expect(body.area.status).to.eql(\"VERIFIED\"); pm.expect(body.area.active).to.eql(true); });",
                  "pm.test(\"No coordinates in the response\", () => pm.expect(pm.response.text()).to.not.include(\"latitude\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify again with the same key (replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{verifyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "verifications"
              ]
            },
            "description": "UC-AR-01 A2: the same Idempotency-Key and body return the stored response; nothing is created twice.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": false,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"Same area\", () => pm.expect(pm.response.json().area.id).to.eql(pm.collectionVariables.get(\"areaId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify - mock location (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{mockKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "verifications"
              ]
            },
            "description": "FR-AR-05: 422 AREA_VERIFICATION_REJECTED with reasons and Vietnamese guidance; the attempt is stored.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": true,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"mockKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"fixTime\", new Date(Date.now() - 5000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Code is AREA_VERIFICATION_REJECTED\", () => pm.expect(pm.response.json().code).to.eql(\"AREA_VERIFICATION_REJECTED\"));",
                  "pm.test(\"Reason MOCK_LOCATION\", () => pm.expect(pm.response.json().reasons).to.include(\"MOCK_LOCATION\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify - no Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "verifications"
              ]
            },
            "description": "SRS section 5.4: 400 IDEMPOTENCY_KEY_REQUIRED.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": false,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Code is IDEMPOTENCY_KEY_REQUIRED\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REQUIRED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Name the area",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/{{areaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "{{areaId}}"
              ]
            },
            "description": "UC-AR-01 step 9.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Nhà\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Renamed\", () => pm.expect(pm.response.json().label).to.eql(\"Nhà\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trading gate after verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/trading-gate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "trading-gate"
              ]
            },
            "description": "F15: open once the area is verified.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gate is open\", () => pm.expect(pm.response.json().open).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. FA2 Renew",
      "item": [
        {
          "name": "Renew the area",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{renewKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/{{areaId}}/renewals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "{{areaId}}",
                "renewals"
              ]
            },
            "description": "UC-AR-02: a fresh fix within 1 500 m of the center; expiresAt moves to now + 30 days.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": false,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"renewKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"fixTime\", new Date(Date.now() - 5000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Renewed\", () => pm.expect(pm.response.json().renewal).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renew - unknown area",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{unknownKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/00000000-0000-0000-0000-000000000000/renewals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "00000000-0000-0000-0000-000000000000",
                "renewals"
              ]
            },
            "description": "UC-AR-02 E3: 404 AREA_NOT_FOUND (also for another user's area).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": 12.5,\n  \"fixTime\": \"{{fixTime}}\",\n  \"mockLocation\": false,\n  \"deviceSignals\": { \"emulator\": false, \"rooted\": false, \"developerOptions\": false, \"mockLocationApp\": null },\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"unknownKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"fixTime\", new Date(Date.now() - 5000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Code is AREA_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"AREA_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. FA4 Active area and range",
      "item": [
        {
          "name": "List my areas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "me"
              ]
            },
            "description": "A27: the caller's areas in slot order.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
