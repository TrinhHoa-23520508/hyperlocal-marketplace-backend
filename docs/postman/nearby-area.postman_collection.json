                ]
              }
            }
          ]
        },
        {
          "name": "Choose an unknown range",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "active"
              ]
            },
            "description": "FR-AR-08: 400 INVALID_RANGE.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaId\": \"{{areaId}}\",\n  \"rangeLevel\": \"HUGE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Code is INVALID_RANGE\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_RANGE\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. FA3 Remove",
      "item": [
        {
          "name": "Remove the area",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/{{areaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "{{areaId}}"
              ]
            },
            "description": "FR-AR-07: 204; the area's listings are hidden.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
