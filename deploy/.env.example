# Copy to deploy/.env and fill in. Never commit the real .env.

APP_IMAGE=ghcr.io/<github-owner>/nearby-backend:latest

POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ISSUER=nearby-backend

MINIO_ROOT_USER=nearby
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=nearby-images
# Public domains served by Nginx. Presigned URLs are signed for STORAGE_DOMAIN, so it must be a
# dedicated host (MinIO cannot sign URLs under a path prefix).
API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
MINIO_PUBLIC_ENDPOINT=https://storage.example.com

# SMS one-time codes through eSMS.vn (FR-ID-02). Never use SMS_PROVIDER=log in production.
SMS_PROVIDER=esms
ESMS_API_KEY=change-me
ESMS_SECRET_KEY=change-me
ESMS_BRANDNAME=change-me
ESMS_SMS_TYPE=2
ESMS_SANDBOX=false
# Must match the template registered with eSMS; {code} is the 6-digit code
SMS_OTP_TEMPLATE={code} la ma xac minh Nearby cua ban, het han sau 5 phut. Khong chia se ma nay.
# openssl rand -base64 48
OTP_HASH_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# SMTP for verification and password reset emails (STARTTLS). Gmail: smtp.gmail.com + App Password.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me-app-password
MAIL_FROM=Nearby <change-me@gmail.com>
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
PASSWORD_RESET_URL=https://app.example.com/reset-password

# First admin account, created on startup. Use a strong password and change it after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Browser origins allowed to call the API (comma-separated), e.g. the admin console.
# Leave empty when the console is served from API_DOMAIN itself.
CORS_ALLOWED_ORIGINS=https://admin.example.com
